{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Still",
  "version": "0.1.0",
  "identifier": "com.still.pomodoro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Still · 專注當下",
        "width": 1200,
        "height": 850,
        "minWidth": 500,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; media-src 'self' blob:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "專注當下，找到你的節奏",
    "category": "Productivity",
    "macOS": { "minimumSystemVersion": "10.13" }
  }
}
